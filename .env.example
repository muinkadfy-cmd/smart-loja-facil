# Variaveis publicas permitidas no frontend/Cloudflare.
# Nunca coloque service_role, JWT secret, VAPID private key ou chaves secretas aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# Alternativas aceitas pelo app, caso voce use nomes novos do Supabase:
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=SUA_PUBLISHABLE_KEY_PUBLICA
# VITE_SUPABASE_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY_PUBLICA
